<?xml version="1.0"?>

<!--
  Generic output protocol: FlightGear to our Python backend.

  Flag syntax (authoritative: $FG_ROOT/Docs/README.IO, lines 22-34):
      fgfs [generic option]=socket,dir,hz,machine,port,style,protocol
      fgfs [generic option]=file,dir,hz,filename,protocol
  where "protocol" is this file's basename without .xml, looked up in
  $FG_ROOT/Protocol/.

  One line per frame, comma separated key=value pairs, e.g.:
      t=12.345,ias=45.50,alt=3500.00,...

  NOTE: the "type" element defaults to "int" in the generic protocol,
  so every float chunk MUST declare type explicitly or values truncate.
-->

<PropertyList>
  <generic>

    <output>
      <binary_mode>false</binary_mode>
      <var_separator>,</var_separator>
      <line_separator>newline</line_separator>

      <!-- clock -->
      <chunk>
        <name>sim elapsed time (s)</name>
        <type>double</type>
        <format>t=%.3f</format>
        <node>/sim/time/elapsed-sec</node>
      </chunk>

      <!-- pitot / air data -->
      <chunk>
        <name>indicated airspeed (kt)</name>
        <type>float</type>
        <format>ias=%.2f</format>
        <node>/velocities/airspeed-kt</node>
      </chunk>
      <chunk>
        <name>mach</name>
        <type>float</type>
        <format>mach=%.3f</format>
        <node>/velocities/mach</node>
      </chunk>

      <!-- baro / altitude -->
      <chunk>
        <name>altitude (ft)</name>
        <type>double</type>
        <format>alt=%.2f</format>
        <node>/position/altitude-ft</node>
      </chunk>
      <chunk>
        <name>altimeter indicated altitude (ft)</name>
        <type>float</type>
        <format>altind=%.2f</format>
        <node>/instrumentation/altimeter/indicated-altitude-ft</node>
      </chunk>
      <chunk>
        <name>altitude AGL (ft)</name>
        <type>double</type>
        <format>agl=%.2f</format>
        <node>/position/altitude-agl-ft</node>
      </chunk>
      <chunk>
        <name>vertical speed (ft/s)</name>
        <type>float</type>
        <format>vs=%.2f</format>
        <node>/velocities/vertical-speed-fps</node>
      </chunk>

      <!-- GPS position + independent ground-speed witness -->
      <chunk>
        <name>latitude (deg)</name>
        <type>double</type>
        <format>lat=%.6f</format>
        <node>/position/latitude-deg</node>
      </chunk>
      <chunk>
        <name>longitude (deg)</name>
        <type>double</type>
        <format>lon=%.6f</format>
        <node>/position/longitude-deg</node>
      </chunk>
      <chunk>
        <name>ground speed north (ft/s)</name>
        <type>float</type>
        <format>vng=%.2f</format>
        <node>/velocities/speed-north-fps</node>
      </chunk>
      <chunk>
        <name>ground speed east (ft/s)</name>
        <type>float</type>
        <format>veg=%.2f</format>
        <node>/velocities/speed-east-fps</node>
      </chunk>

      <!-- mag heading + attitude -->
      <chunk>
        <name>heading (deg)</name>
        <type>float</type>
        <format>hdg=%.2f</format>
        <node>/orientation/heading-deg</node>
      </chunk>
      <chunk>
        <name>pitch (deg)</name>
        <type>float</type>
        <format>pitch=%.2f</format>
        <node>/orientation/pitch-deg</node>
      </chunk>
      <chunk>
        <name>roll (deg)</name>
        <type>float</type>
        <format>roll=%.2f</format>
        <node>/orientation/roll-deg</node>
      </chunk>

      <!-- AoA vane + sideslip -->
      <chunk>
        <name>angle of attack (deg)</name>
        <type>float</type>
        <format>alpha=%.3f</format>
        <node>/orientation/alpha-deg</node>
      </chunk>
      <chunk>
        <name>sideslip (deg)</name>
        <type>float</type>
        <format>beta=%.3f</format>
        <node>/orientation/beta-deg</node>
      </chunk>

      <!-- gyro: body rates (NOTE: /orientation/p-body, NOT /velocities/p-body) -->
      <chunk>
        <name>roll rate p (rad/s)</name>
        <type>float</type>
        <format>p=%.4f</format>
        <node>/orientation/p-body</node>
      </chunk>
      <chunk>
        <name>pitch rate q (rad/s)</name>
        <type>float</type>
        <format>q=%.4f</format>
        <node>/orientation/q-body</node>
      </chunk>
      <chunk>
        <name>yaw rate r (rad/s)</name>
        <type>float</type>
        <format>r=%.4f</format>
        <node>/orientation/r-body</node>
      </chunk>

      <!-- accelerometers: pilot body-axis accel (ft/s^2) -->
      <chunk>
        <name>x accel (ft/s^2)</name>
        <type>float</type>
        <format>ax=%.3f</format>
        <node>/accelerations/pilot/x-accel-fps_sec</node>
      </chunk>
      <chunk>
        <name>y accel (ft/s^2)</name>
        <type>float</type>
        <format>ay=%.3f</format>
        <node>/accelerations/pilot/y-accel-fps_sec</node>
      </chunk>
      <chunk>
        <name>z accel (ft/s^2)</name>
        <type>float</type>
        <format>az=%.3f</format>
        <node>/accelerations/pilot/z-accel-fps_sec</node>
      </chunk>

      <!-- control inputs (for the dashboard) -->
      <chunk>
        <name>elevator (norm)</name>
        <type>float</type>
        <format>elev=%.3f</format>
        <node>/controls/flight/elevator</node>
      </chunk>
      <chunk>
        <name>aileron (norm)</name>
        <type>float</type>
        <format>ail=%.3f</format>
        <node>/controls/flight/aileron</node>
      </chunk>
      <chunk>
        <name>rudder (norm)</name>
        <type>float</type>
        <format>rud=%.3f</format>
        <node>/controls/flight/rudder</node>
      </chunk>
      <chunk>
        <name>throttle (norm)</name>
        <type>float</type>
        <format>thr=%.3f</format>
        <node>/controls/engines/engine[0]/throttle</node>
      </chunk>

    </output>

  </generic>
</PropertyList>
